@page "/backlog"
@inject HttpClient Http

<div class="swimlane-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
        <div class="d-flex justify-end pa-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateNewPbi">
                New PBI
            </MudButton>
        </div>
        <SwimLanes @ref="_swimLanes"
                   GroupByPriority
                   InitialSprintId="-1"
                   OnPbiSelected="OpenPbiDetails" />
    </MudContainer>

    @if (SelectedPbi is not null)
    {
        <div class="details-overlay">
            <div class="details-container">
                <div class="details-header">
                    <MudText Typo="Typo.h5" Class="details-title">
                        <MudIcon Icon="@(_isCreating ? Icons.Material.Filled.Add : Icons.Material.Filled.Visibility)" Class="me-2" />
                        @(_isCreating ? "Create New PBI" : "PBI Details")
                    </MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Close"
                               OnClick="ClosePbiDetails"
                               Class="close-button">
                        Close
                    </MudButton>
                </div>

                <div class="details-content">
                    <div class="details-card">
                        <PbiCard PbiModel="SelectedPbi"
                                 OnSave="HandlePbiSave"
                                 OnDelete="HandlePbiDelete"
                                 StartInEditMode="_isCreating" />
                    </div>
                    @if (!_isCreating)
                    {
                        <CommentThread PbiId="SelectedPbi.PbiId" />
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SwimLanes? _swimLanes;
    private ProductBacklogItem? SelectedPbi;
    private bool _isCreating;

    private void OpenPbiDetails(ProductBacklogItem pbi)
    {
        _isCreating = false;
        SelectedPbi = pbi;
    }

    private void CreateNewPbi()
    {
        _isCreating = true;
        SelectedPbi = new ProductBacklogItem
        {
            Title = "",
            Description = "",
            Status = PbiStatus.ToDo,
            Priority = PbiPriority.Medium,
            StoryPoints = PbiPoints.Zero,
            Origin = PbiOrigin.WebUserCreated,
            IsDraft = false,
            DateCreated = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow
        };
    }

    private async Task ClosePbiDetails()
    {
        SelectedPbi = null;
        _isCreating = false;
        if (_swimLanes is not null)
            await _swimLanes.RefreshAsync();
    }

    private async Task HandlePbiSave(ProductBacklogItem pbi)
    {
        try
        {
            HttpResponseMessage response;
            if (_isCreating)
            {
                response = await Http.PostAsJsonAsync("api/Pbi/createStory", pbi);
            }
            else
            {
                response = await Http.PutAsJsonAsync("api/Pbi", pbi);
            }

            if (response.IsSuccessStatusCode)
            {
                SelectedPbi = null;
                _isCreating = false;
                if (_swimLanes is not null)
                    await _swimLanes.RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving story: {ex.Message}");
        }
    }

    private async Task HandlePbiDelete(int storyId)
    {
        SelectedPbi = null;
        _isCreating = false;
        if (_swimLanes is not null)
            await _swimLanes.RefreshAsync();
    }
}
