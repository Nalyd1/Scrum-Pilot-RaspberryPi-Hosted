# Docker Hub username (must match what's in deploy.yml)
DOCKER_USERNAME=your-dockerhub-username

# URL the browser uses to reach the API — set to your Pi's Tailscale hostname
# Example: http://my-pi.tail12345.ts.net:5219/
API_BASE_URL=http://YOUR_PI_TAILSCALE_HOSTNAME:5219/

# JWT signing key — generate a random string (e.g., openssl rand -base64 32)
JWT_KEY=CHANGE-ME-generate-a-random-secret-key
